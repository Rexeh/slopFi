# Copy to .env (git-ignored) and edit. docker compose reads it automatically.

# Host folder mounted at /data in the container: the database, sources.toml, rules.local.json and statements.
# Absolute or relative to this file. It must exist and be writable by PUID:PGID.
SLOPFI_DATA_DIR=./docker-data

# Host user and group the app runs as; `id -u` and `id -g` give yours.
PUID=1000
PGID=1000

# Address and port on the host. 0.0.0.0 serves the whole home network; 127.0.0.1 keeps it to this machine.
# Published Docker ports bypass ufw/firewalld rules, so do not rely on the host firewall to hide it.
SLOPFI_BIND=0.0.0.0
SLOPFI_PORT=8000
